# Application Configuration
APP_NAME="Smart Basket API"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database Configuration (matches local docker-compose service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_basket
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_basket
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_basket

# Redis Configuration (matches local docker-compose redis service for Pub/Sub & WebSockets)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# JWT Authentication & Household Security
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
