# Application Configuration
APP_NAME="Smart Basket API"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database Configuration (matches local docker-compose service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_basket
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_basket
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_basket

